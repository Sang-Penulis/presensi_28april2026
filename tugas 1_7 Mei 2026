# =====================================
# MENAMPILKAN GRAFIK OUTPUT
# =====================================

GambarNilaiAkhir()


# =====================================
# DEFUZZIFIKASI
# =====================================

def defuzzifikasi(sample: int, rest: restoran) -> restoran:

    parm = {

        "batas_bawah": 1,

        "buruk_c": 40,
        "buruk_d": 80,

        "bagus_a": 40,
        "bagus_b": 80,

        "batas_atas": 100
    }

    pembilang = 0
    penyebut = 0

    increment = 100 // sample

    for i in range(sample):

        bilangan = (i + 1) * increment

        # =====================================
        # DAERAH BURUK
        # =====================================

        if bilangan <= parm['buruk_c']:

            pembilang += bilangan * rest.buruk_akhir
            penyebut += rest.buruk_akhir

        # =====================================
        # DAERAH BAGUS
        # =====================================

        elif bilangan >= parm['bagus_b']:

            pembilang += bilangan * rest.bagus_akhir
            penyebut += rest.bagus_akhir

        # =====================================
        # DAERAH TRANSISI
        # =====================================

        else:

            nilai_asli_buruk = (
                -(bilangan - parm['buruk_d']) /
                (parm['buruk_d'] - parm['buruk_c'])
            )

            nilai_asli_bagus = (
                (bilangan - parm['bagus_a']) /
                (parm['bagus_b'] - parm['bagus_a'])
            )

            nilai_terkecil_buruk = min(
                nilai_asli_buruk,
                rest.buruk_akhir
            )

            nilai_terkecil_bagus = min(
                nilai_asli_bagus,
                rest.bagus_akhir
            )

            nilai_max = max(
                nilai_terkecil_buruk,
                nilai_terkecil_bagus
            )

            pembilang += bilangan * nilai_max
            penyebut += nilai_max

    # =====================================
    # MENGHITUNG NILAI AKHIR
    # =====================================

    if penyebut != 0:

        rest.nilai_akhir = pembilang // penyebut

    else:

        rest.nilai_akhir = 0

    return rest


# =====================================
# MENJALANKAN DEFUZZIFIKASI
# =====================================

for i in range(len(restoran_data)):

    restoran_data[i] = defuzzifikasi(
        20,
        restoran_data[i]
    )


# =====================================
# SORTING NILAI AKHIR
# =====================================

def NilaiAkhirSort(restoran_temp):

    restoran_temp = sorted(
        restoran_temp,
        key=lambda x: x.nilai_akhir,
        reverse=True
    )

    return restoran_temp


# =====================================
# MENGURUTKAN DATA
# =====================================

restoran_data = NilaiAkhirSort(restoran_data)


# =====================================
# MENGAMBIL 10 RESTORAN TERBAIK
# =====================================

peringkat = []

for i in range(10):

    peringkat.append([
        restoran_data[i].id_restoran
    ])


# =====================================
# MEMBUAT DATAFRAME OUTPUT
# =====================================

df_akhir = pd.DataFrame(
    peringkat,
    columns=['id']
)


# =====================================
# MENYIMPAN KE FILE EXCEL
# =====================================

df_akhir.to_excel(
