import pandas as pd
import matplotlib.pyplot as plt

# =====================================
# MEMBACA FILE EXCEL
# =====================================

df = pd.read_excel('restoran.xls')


# =====================================
# CLASS RESTORAN
# =====================================

class restoran:

    def __init__(self):

        # Data Awal
        self.id_restoran = 0
        self.pelayanan = 0
        self.makanan = 0

        # FUZZIFIKASI INPUT

        # Makanan
        self.makanan_enak = -1
        self.makanan_tidakenak = -1

        # Pelayanan
        self.pelayanan_baik = -1
        self.pelayanan_biasa = -1
        self.pelayanan_jelek = -1

        # INFERENSI OUTPUT
        self.bagus = []
        self.buruk = []

        self.bagus_akhir = 0
        self.buruk_akhir = 0

        # DEFUZZIFIKASI
        self.nilai_akhir = 0

    def tampilData(self):

        print(
            'ID : {} \nPelayanan : {} \nMakanan : {} \nNilai Akhir : {}\n'.format(
                self.id_restoran,
                self.pelayanan,
                self.makanan,
                self.nilai_akhir
            )
        )


# =====================================
# MEMASUKKAN DATA KE LIST
# =====================================

restoran_data = []

for i in range(len(df)):

    restoran_temp = restoran()

    restoran_temp.id_restoran = df.iloc[i][0]
    restoran_temp.pelayanan = df.iloc[i][1]
    restoran_temp.makanan = df.iloc[i][2]

    restoran_data.append(restoran_temp)


