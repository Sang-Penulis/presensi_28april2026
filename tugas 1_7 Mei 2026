GambarPelayanan()
GambarMakanan()


# =====================================
# FUZZIFIKASI
# =====================================

def fuzzifikasi(restoran_temp):

    for i in range(len(restoran_temp)):

        # =====================================
        # FUZZY PELAYANAN
        # =====================================

        if 1 <= restoran_temp[i].pelayanan <= 20:

            restoran_temp[i].pelayanan_jelek = 1

        elif 20 < restoran_temp[i].pelayanan < 40:

            restoran_temp[i].pelayanan_jelek = (
                -(restoran_temp[i].pelayanan - 40) / (40 - 20)
            )

            restoran_temp[i].pelayanan_biasa = (
                (restoran_temp[i].pelayanan - 20) / (40 - 20)
            )

        elif 40 <= restoran_temp[i].pelayanan <= 60:

            restoran_temp[i].pelayanan_biasa = 1

        elif 60 < restoran_temp[i].pelayanan < 90:

            restoran_temp[i].pelayanan_biasa = (
                -(restoran_temp[i].pelayanan - 90) / (90 - 60)
            )

            restoran_temp[i].pelayanan_baik = (
                (restoran_temp[i].pelayanan - 60) / (90 - 60)
            )

        elif 90 <= restoran_temp[i].pelayanan <= 100:

            restoran_temp[i].pelayanan_baik = 1

        # =====================================
        # FUZZY MAKANAN
        # =====================================

        if 1 <= restoran_temp[i].makanan <= 4:

            restoran_temp[i].makanan_tidakenak = 1

        elif 4 < restoran_temp[i].makanan < 7:

            restoran_temp[i].makanan_tidakenak = (
                -(restoran_temp[i].makanan - 7) / (7 - 4)
            )

            restoran_temp[i].makanan_enak = (
                (restoran_temp[i].makanan - 4) / (7 - 4)
            )

        elif 7 <= restoran_temp[i].makanan <= 10:

            restoran_temp[i].makanan_enak = 1

    return restoran_temp


# =====================================
# MENJALANKAN FUZZIFIKASI
# =====================================

restoran_data = fuzzifikasi(restoran_data)


# =====================================
# INFERENSI
# =====================================

def inferensi(restoran_temp):

    for i in range(len(restoran_temp)):

        # =====================================
        # MAKANAN TIDAK ENAK
        # =====================================

        if restoran_temp[i].makanan_tidakenak != -1:

            if restoran_temp[i].pelayanan_jelek != -1:

                restoran_temp[i].buruk.append(
                    min(
                        restoran_temp[i].makanan_tidakenak,
                        restoran_temp[i].pelayanan_jelek
                    )
                )

            if restoran_temp[i].pelayanan_biasa != -1:

                restoran_temp[i].buruk.append(
                    min(
                        restoran_temp[i].makanan_tidakenak,
                        restoran_temp[i].pelayanan_biasa
                    )
                )

            if restoran_temp[i].pelayanan_baik != -1:

                restoran_temp[i].buruk.append(
                    min(
                        restoran_temp[i].makanan_tidakenak,
                        restoran_temp[i].pelayanan_baik
                    )
                )

        # =====================================
        # MAKANAN ENAK
        # =====================================

        if restoran_temp[i].makanan_enak != -1:

            if restoran_temp[i].pelayanan_jelek != -1:

                restoran_temp[i].buruk.append(
                    min(
                        restoran_temp[i].makanan_enak,
                        restoran_temp[i].pelayanan_jelek
                    )
                )

            if restoran_temp[i].pelayanan_biasa != -1:

                restoran_temp[i].bagus.append(
                    min(
                        restoran_temp[i].makanan_enak,
                        restoran_temp[i].pelayanan_biasa
                    )
                )

            if restoran_temp[i].pelayanan_baik != -1:

                restoran_temp[i].bagus.append(
                    min(
                        restoran_temp[i].makanan_enak,
                        restoran_temp[i].pelayanan_baik
                    )
                )

        # =====================================
        # MENGAMBIL NILAI MAKSIMUM
        # =====================================

        if len(restoran_temp[i].bagus) != 0:

            restoran_temp[i].bagus_akhir = max(
                restoran_temp[i].bagus
            )

        if len(restoran_temp[i].buruk) != 0:

            restoran_temp[i].buruk_akhir = max(
                restoran_temp[i].buruk
            )

    return restoran_temp


# =====================================
# MENJALANKAN INFERENSI
# =====================================

restoran_data = inferensi(restoran_data)


