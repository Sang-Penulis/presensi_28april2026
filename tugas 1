def defuzzifikasi(sample: int, rest: restoran) -> restoran:
# Membuat fungsi defuzzifikasi
# sample = jumlah titik sampling
# rest = objek restoran

    # =====================================
    # PARAMETER FUNGSI KEANGGOTAAN OUTPUT
    # =====================================

    parm = {

        "batas_bawah" : 1,
        # Nilai minimum output

        "buruk_c" : 40,
        # Batas akhir daerah penuh BURUK

        "buruk_d" : 80,
        # Batas akhir transisi BURUK

        "bagus_a" : 40,
        # Awal transisi BAGUS

        "bagus_b" : 80,
        # Awal daerah penuh BAGUS

        "batas_atas": 100
        # Nilai maksimum output
    }

    pembilang = 0
    # Variabel untuk menyimpan total pembilang rata-rata terbobot

    penyebut = 0
    # Variabel untuk menyimpan total penyebut rata-rata terbobot

    increment = 100 // sample
    # Menentukan jarak antar sampel

    for i in (range(sample-0)):
    # Perulangan sebanyak jumlah sample

        bilangan = (i+1) * increment
        # Membuat nilai sampling

        # print(bilangan)
        # Digunakan untuk debugging jika ingin melihat nilai sampling


        if bilangan <= parm['buruk_c']:
        # Jika nilai sampling berada di daerah BURUK penuh

            pembilang += bilangan*rest.buruk_akhir
            # Menambahkan hasil perkalian nilai sampling
            # dengan derajat buruk akhir ke pembilang

            penyebut += rest.buruk_akhir
            # Menambahkan derajat buruk akhir ke penyebut


        elif bilangan >= parm['bagus_b']:
        # Jika nilai sampling berada di daerah BAGUS penuh

            pembilang += bilangan*rest.bagus_akhir
            # Menambahkan hasil perkalian nilai sampling
            # dengan derajat bagus akhir ke pembilang

            penyebut += rest.bagus_akhir
            # Menambahkan derajat bagus akhir ke penyebut


        else:
        # Jika nilai sampling berada di daerah transisi

            nilai_asli_buruk = -(bilangan - parm['buruk_d']) / (parm['buruk_d'] - parm['buruk_c'])
            # Menghitung derajat keanggotaan asli BURUK

            nilai_asli_bagus = (bilangan - parm['bagus_a']) / (parm['bagus_b'] - parm['bagus_a'])
            # Menghitung derajat keanggotaan asli BAGUS


            nilai_terkecil_buruk = min([nilai_asli_buruk, rest.buruk_akhir])
            # Mengambil nilai minimum antara
            # derajat asli buruk dan buruk akhir

            nilai_terkecil_bagus = min([nilai_asli_bagus, rest.bagus_akhir])
            # Mengambil nilai minimum antara
            # derajat asli bagus dan bagus akhir


            nilai_max = max([nilai_terkecil_buruk, nilai_terkecil_bagus])
            # Mengambil nilai maksimum dari kedua hasil minimum


            pembilang += bilangan*nilai_max
            # Menambahkan hasil perkalian nilai sampling
            # dengan nilai maksimum ke pembilang

            penyebut += nilai_max
            # Menambahkan nilai maksimum ke penyebut


    rest.nilai_akhir = pembilang // penyebut
    # Menghitung nilai akhir menggunakan metode rata-rata terbobot


    return rest
    # Mengembalikan objek restoran yang sudah didefuzzifikasi


