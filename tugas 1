def inferensi(restoran_temp):
# Membuat fungsi inferensi dengan parameter restoran_temp

    for i in range  (len(restoran_temp)):
    # Perulangan sebanyak jumlah data restoran

      if restoran_temp[i].makanan_tidakenak != -1:
      # Jika makanan memiliki nilai keanggotaan tidak enak

          if restoran_temp[i].pelayanan_jelek != -1:
          # Jika pelayanan memiliki nilai keanggotaan jelek

              restoran_temp[i].buruk.append(
                  min(
                      restoran_temp[i].makanan_tidakenak,
                      restoran_temp[i].pelayanan_jelek
                  )
              )
              # Mengambil nilai minimum dari makanan tidak enak
              # dan pelayanan jelek lalu dimasukkan ke list buruk

          if restoran_temp[i].pelayanan_biasa != -1:
          # Jika pelayanan memiliki nilai keanggotaan biasa

              restoran_temp[i].buruk.append(
                  min(
                      restoran_temp[i].makanan_tidakenak,
                      restoran_temp[i].pelayanan_biasa
                  )
              )
              # Mengambil nilai minimum dari makanan tidak enak
              # dan pelayanan biasa lalu dimasukkan ke list buruk

          if restoran_temp[i].pelayanan_baik != -1:
          # Jika pelayanan memiliki nilai keanggotaan baik

              restoran_temp[i].buruk.append(
                  min(
                      restoran_temp[i].makanan_tidakenak,
                      restoran_temp[i].pelayanan_baik
                  )
              )
              # Mengambil nilai minimum dari makanan tidak enak
              # dan pelayanan baik lalu dimasukkan ke list buruk


      if restoran_temp[i].makanan_enak != -1:
      # Jika makanan memiliki nilai keanggotaan enak

          if restoran_temp[i].pelayanan_jelek != -1:
          # Jika pelayanan memiliki nilai keanggotaan jelek

              restoran_temp[i].buruk.append(
                  min(
                      restoran_temp[i].makanan_enak,
                      restoran_temp[i].pelayanan_jelek
                  )
              )
              # Mengambil nilai minimum dari makanan enak
              # dan pelayanan jelek lalu dimasukkan ke list buruk

          if restoran_temp[i].pelayanan_biasa != -1:
          # Jika pelayanan memiliki nilai keanggotaan biasa

              restoran_temp[i].bagus.append(
                  min(
                      restoran_temp[i].makanan_enak,
                      restoran_temp[i].pelayanan_biasa
                  )
              )
              # Mengambil nilai minimum dari makanan enak
              # dan pelayanan biasa lalu dimasukkan ke list bagus

          if restoran_temp[i].pelayanan_baik != -1:
          # Jika pelayanan memiliki nilai keanggotaan baik

              restoran_temp[i].bagus.append(
                  min(
                      restoran_temp[i].makanan_enak,
                      restoran_temp[i].pelayanan_baik
                  )
              )
              # Mengambil nilai minimum dari makanan enak
              # dan pelayanan baik lalu dimasukkan ke list bagus


      if len(restoran_temp[i].bagus) != 0:
      # Jika list bagus tidak kosong

          restoran_temp[i].bagus_akhir = max(restoran_temp[i].bagus)
          # Mengambil nilai maksimum dari list bagus


      if len(restoran_temp[i].buruk) != 0:
      # Jika list buruk tidak kosong

          restoran_temp[i].buruk_akhir = max(restoran_temp[i].buruk)
          # Mengambil nilai maksimum dari list buruk


    return restoran_temp
    # Mengembalikan data restoran yang sudah melalui inferensi


